@implements IDisposable
@inject IJSRuntime JS
<header class="top"><div class="navwrap"><a class="brand" href="./"><img src="mark.svg" alt="">Kernport<span class="arcade">Arcade</span></a>
<nav aria-label="Hauptnavigation"><button class="navbtn active" @onclick='()=>Close()'><Icon Name="grid"/> Spiel</button><button class="navbtn" @onclick='()=>Dialog("Statistik")'><Icon Name="stats"/> Statistik</button><button class="navbtn" @onclick='()=>Dialog("Anleitung")'><Icon Name="help"/> Anleitung</button></nav>
<button class="theme" aria-label="Farbschema wechseln" title="Farbschema wechseln" @onclick="ToggleTheme"><Icon Name="@(dark?"sun":"moon")"/></button></div></header>
<main>
<div class="heading"><div><div class="eyebrow"><i></i> KERNPORT ARCADE</div><h1>Minesweeper<span>.</span></h1><p>Decke alle Felder ohne Mine auf.</p></div><div class="titleart" aria-hidden="true">@foreach(var tile in new[]{"n","b","n","b","m","b","n","b","n"}){<i class="@tile">@if(tile=="m"){<Icon Name="mine"/>}</i>}</div></div>
<div class="columns"><section class="game" aria-label="Spielkonsole"><div class="gametop"><div class="consolelabel"><i></i> SPIELKONSOLE</div><span class="live">@StateLabel</span></div>
<div class="meters"><div><Icon Name="flag"/><span>MINEN<strong>@((board.Size.Mines-board.FlagCount).ToString("D3"))</strong></span></div><div><Icon Name="clock"/><span>ZEIT<strong>@TimeText(Seconds)</strong></span></div><div><Icon Name="grid"/><span>FELD<strong>@board.Size.Width<small>×</small>@board.Size.Height</strong></span></div></div>
<div class="stage"><div class="scroller" aria-label="Spielfeld, große Felder sind scrollbar"><div class="board" style="--cols:@board.Size.Width" role="group" aria-label="Minenfeld">
@for(int n=0;n<board.Size.Count;n++){
 int i=n; var clue=board.Clue(i); bool mine=board.ExposedMine(i);
 <button id="@($"c{i}")" data-cell="@i" tabindex="@(focusCell==i?0:-1)" aria-label="@Label(i)" class="cell @(board.Open[i]?"open c"+clue:"closed") @(board.Flags[i]?"flag":"") @(mine?"mine":"") @(board.Trigger==i?"boom":"") @(advice?.Sources.Contains(i)==true?"source":"") @(advice?.Targets.Contains(i)==true?"target":"") @(DailyTarget(i)?"dailycell":"")" @onfocus="()=>focusCell=i" @onclick="()=>Play(i,flagTool)" @oncontextmenu="()=>Play(i,true)" @oncontextmenu:preventDefault>
 @if(board.Trigger==i || (mine && !board.Flags[i])){<Icon Name="mine"/>}else if(board.Flags[i]){<Icon Name="flag"/>@if(board.Phase==Phase.Lost && !mine){<b class="wrong">×</b>}}else if(clue>0){@clue}else if(DailyTarget(i)){<span>◎</span>}
 </button>
}</div></div></div>
<div class="toolbar"><div class="tools" aria-label="Spielwerkzeug"><button class="@(!flagTool?"selected":"")" aria-pressed="@(!flagTool)" @onclick="()=>flagTool=false"><Icon Name="pointer"/> Aufdecken</button><button class="@(flagTool?"selected":"")" aria-pressed="@flagTool" @onclick="()=>flagTool=true"><Icon Name="flag"/> Flagge</button></div><button class="hint" @onclick="Hint" disabled="@(busy || board.Phase!=Phase.Playing)"><Icon Name="bulb"/> Hinweis</button></div>
<p class="message" role="status">@Message @if(busy){<button @onclick="Cancel">Abbrechen</button>} @if(board.Phase is Phase.Lost or Phase.Won){<button @onclick="Again">Noch einmal spielen</button>}</p></section>
<aside><section class="panel"><h2><Icon Name="settings"/> Spieleinstellungen</h2><div class="form">
<label for="mode">Spielmodus</label><select id="mode" @bind="draftMode" @bind:after="()=>{if(draftMode==Mode.Daily)level=1;}"><option value="Classic">Klassisch</option><option value="Logic">Logikmodus</option><option value="Daily">Tagesaufgabe</option></select>
<label for="level">Schwierigkeit</label><select id="level" @bind="level" disabled="@(draftMode==Mode.Daily)"><option value="0">Anfänger</option><option value="1">Fortgeschrittene</option><option value="2">Experten</option><option value="3">Benutzerdefiniert</option></select>
@if(level==3 && draftMode!=Mode.Daily){<div class="dimensions">@foreach(var d in new[]{"Breite","Höhe","Minen"}){<label>@d<input type="number" value="@(d=="Breite"?width:d=="Höhe"?height:mines)" @onchange="e=>Dimension(d,e.Value?.ToString())"/></label>}</div>}
<div class="summary"><span><Icon Name="grid"/> @Selected.Width × @Selected.Height</span><span><Icon Name="mine"/> @Selected.Mines Minen</span></div>
@if(!Selected.Valid){<p role="alert">Breite 5–40, Höhe 5–30. Für den Start müssen neun Felder frei bleiben.</p>}
<button class="primary" @onclick="RequestStart" disabled="@(!Selected.Valid || busy)"><Icon Name="restart"/> Neues Spiel</button></div></section>
<section class="daily"><div class="eyebrow"><Icon Name="calendar"/> TAGESAUFGABE</div><h2>Ein Tag, ein Feld.</h2><p>Jeden Tag ein neues Minenfeld.<br>Für alle das gleiche.</p><button @onclick="RequestDaily" disabled="@busy">Tagesaufgabe spielen <span aria-hidden="true">→</span></button><div class="dailyart" aria-hidden="true"><Icon Name="flag"/></div></section>
</aside></div><footer><span><i></i> KERNPORT ARCADE</span><button @onclick='()=>Dialog("Anleitung")'>Spielanleitung</button></footer></main>
@if(dialog!=""){<dialog aria-labelledby="dialog-title" @oncancel="Close"><h2 id="dialog-title">@dialog</h2>
@if(dialog=="Neue Partie starten?"){<p>Die laufende Partie wird ersetzt.</p><button class="primary" @onclick="StartSelected">Neu starten</button>}
else if(dialog=="Anleitung"){<p>Decke alle Felder ohne Mine auf. Jede Zahl verrät, wie viele der acht umliegenden Felder Minen enthalten. Das erste Aufdecken öffnet eine sichere Fläche.</p><p>Setze Flaggen per Rechtsklick oder mit dem Werkzeug „Flagge“. Klicke auf eine offene Zahl, wenn ihre Minen markiert sind. Falsch gesetzte Flaggen können dabei eine Mine auslösen.</p><p><kbd>Tab</kbd> zum Brett, Pfeiltasten zum Bewegen, <kbd>Enter</kbd> oder Leertaste zum Aufdecken, <kbd>F</kbd> für eine Flagge. Auf dem Handy kannst du große Bretter verschieben.</p><p>Im Logikmodus prüft ein Solver jeden Start. Hinweise markieren die erklärenden Zahlen und das Zielfeld. Die Tagesaufgabe wechselt um 00:00 UTC.</p>}
else {<p>Abgeschlossene Partien auf diesem Gerät. Bestzeiten zählen ab dem ersten Aufdecken.</p>@if(history.Count==0){<p>Noch keine abgeschlossenen Partien.</p>}else{<table><thead><tr><th>Wertung</th><th>Siege / Spiele</th><th>Bestzeit</th></tr></thead><tbody>@foreach(var g in history.GroupBy(x=>x.Group)){<tr><td>@g.Key</td><td>@g.Count(x=>x.Won) / @g.Count()</td><td>@(g.Any(x=>x.Won)?TimeText(g.Where(x=>x.Won).Min(x=>x.Seconds)):"—")</td></tr>}</tbody></table>}}
<button class="secondary" @onclick="Close">@(dialog=="Neue Partie starten?"?"Weiterspielen":"Schließen")</button></dialog>}
