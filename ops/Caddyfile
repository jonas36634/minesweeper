minesweeper.kernport.de {
    redir https://minesweeper.kernport.com{uri} permanent
}

minesweeper.kernport.com {
    root * /srv/minesweeper/current
    encode zstd gzip
    header Cache-Control "no-cache"
    header X-Content-Type-Options "nosniff"
    @assets path /_framework/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server {
        precompressed br gzip
    }
}
